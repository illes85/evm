# Szebb útvonalak, ha a tárhelyen van mod_rewrite. Ha nincs, az API akkor is
# működik a ?r=... formával, ezért a blokk hibatűrő.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ index.php?r=$1 [QSA,L]
</IfModule>

# Böngészőből ne lehessen listázni a könyvtárat.
Options -Indexes
